<mujoco model="rebot_rs_teleop_empty">
  <include file="rs_arm.xml"/>
  <compiler angle="radian" meshdir="meshes/"/>

  <option timestep="0.001" iterations="100" solver="Newton" integrator="Euler"/>

  <contact>
    <exclude body1="world" body2="link1"/>
    <exclude body1="base_link" body2="link1"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link2" body2="link5"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link3" body2="link5"/>
    <exclude body1="link4" body2="link5"/>
    <exclude body1="link5" body2="link6"/>
    <exclude body1="gripper_left" body2="gripper_right"/>
  </contact>

  <statistic center="0.25 0 0.18" extent="0.62"/>

  <visual>
    <headlight diffuse="0.68 0.68 0.68" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.22 0.30 1"/>
    <global azimuth="125" elevation="-23"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.30 0.48 0.65" rgb2="0.04 0.06 0.08" width="512" height="3072"/>
    <texture type="2d" name="rs_ground_tex" builtin="checker" mark="edge" rgb1="0.22 0.28 0.31" rgb2="0.10 0.14 0.16" markrgb="0.72 0.78 0.80" width="300" height="300"/>
    <material name="rs_ground" texture="rs_ground_tex" texuniform="true" texrepeat="6 6" reflectance="0.12"/>
    <material name="axis_red" rgba="0.95 0.10 0.10 1"/>
    <material name="axis_green" rgba="0.10 0.80 0.15 1"/>
    <material name="axis_blue" rgba="0.12 0.35 0.95 1"/>
  </asset>

  <worldbody>
    <light pos="0.25 -0.15 1.3" dir="0.05 0.1 -1" directional="true"/>
    <camera name="teleop_view" mode="fixed" pos="0.95 -0.85 0.62" xyaxes="0.7944 0.6075 0 -0.2443 0.3195 0.9157" fovy="45"/>
    <geom name="floor" type="plane" size="1 1 0.04" material="rs_ground" friction="1.2 0.01 0.001"/>

    <!-- EE goal pose marker: RGB axis triad (x=red, y=green, z=blue) whose
         origin is the commanded gripper-center (tcp) position and whose
         orientation is the commanded orientation. Driven as a mocap body by
         teleop_sim every frame; non-colliding, purely visual. -->
    <body name="ik_target" mocap="true" pos="0.302 0 0.218">
      <site name="ik_target_site" pos="0 0 0" size="0.004" rgba="0.9 0.9 0.9 0.9"/>
      <geom name="axis_x" type="cylinder" fromto="0 0 0  0.07 0 0" size="0.0032"
            material="axis_red" contype="0" conaffinity="0"/>
      <geom name="axis_x_tip" type="sphere" pos="0.07 0 0" size="0.006"
            material="axis_red" contype="0" conaffinity="0"/>
      <geom name="axis_y" type="cylinder" fromto="0 0 0  0 0.07 0" size="0.0032"
            material="axis_green" contype="0" conaffinity="0"/>
      <geom name="axis_y_tip" type="sphere" pos="0 0.07 0" size="0.006"
            material="axis_green" contype="0" conaffinity="0"/>
      <geom name="axis_z" type="cylinder" fromto="0 0 0  0 0 0.07" size="0.0032"
            material="axis_blue" contype="0" conaffinity="0"/>
      <geom name="axis_z_tip" type="sphere" pos="0 0 0.07" size="0.006"
            material="axis_blue" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <!-- qpos: joint1..joint6, joint7 (gripper drive), joint_left, joint_right.
       "rest" = all zeros = the arm's physical resting pose = motor zeros
       (joint1 re-zeroed 2026-10-08) = URDF q=0, gripper closed. The torque
       <motor> actuators hold it via the runtime PD loop, not keyframe ctrl. -->
  <keyframe>
    <key name="rest" qpos="0 0 0 0 0 0 0 0 0" ctrl="0 0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
